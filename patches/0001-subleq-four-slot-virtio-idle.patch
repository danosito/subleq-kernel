diff --git a/arch/subleq/kernel/qemu-mmio.S b/arch/subleq/kernel/qemu-mmio.S
new file mode 100644
index 000000000..b41ec517e
--- /dev/null
+++ b/arch/subleq/kernel/qemu-mmio.S
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <asm/subleq-regs.h>
+
+	.text
+	.globl subleq_mmio_read32
+	.type subleq_mmio_read32,@function
+subleq_mmio_read32:
+	.word REG_Z, REG_Z, .+4
+	.word REG_R21 | INDIRECT, REG_Z, .+4
+	.word REG_R20, REG_R20, .+4
+	.word REG_Z, REG_R20, .+4
+	.word REG_Z, REG_Z, REG_RA | INDIRECT
+	.size subleq_mmio_read32, . - subleq_mmio_read32
+
+	.globl subleq_mmio_write32
+	.type subleq_mmio_write32,@function
+subleq_mmio_write32:
+	/* R21 is the zero-on-read alias. Stage -value in register RAM. */
+	.word REG_Z, REG_Z, .+4
+	.word REG_R22, REG_Z, .+4
+	.word REG_Z, REG_R21 | INDIRECT, .+4
+	.word REG_Z, REG_Z, REG_RA | INDIRECT
+	.size subleq_mmio_write32, . - subleq_mmio_write32
diff --git a/arch/subleq/kernel/qemu-virtio.c b/arch/subleq/kernel/qemu-virtio.c
new file mode 100644
index 000000000..00dafa2ce
--- /dev/null
+++ b/arch/subleq/kernel/qemu-virtio.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0
+#include <linux/dma-mapping.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqdesc.h>
+#include <linux/platform_device.h>
+#include <linux/virtio_blk.h>
+#include <linux/virtio_ids.h>
+#include <linux/virtio_mmio.h>
+
+static u32 subleq_virtio_registered;
+
+void subleq_dispatch_virtio_irq(void)
+{
+	u32 registered = READ_ONCE(subleq_virtio_registered);
+
+	/* Sample once per timer entry. Each shared handler ACKs its own device. */
+	if (registered &&
+	    (subleq_mmio_read32((void __iomem *)SUBLEQ_VIRTIO_PENDING) & registered))
+		generic_handle_irq(SUBLEQ_VIRTIO_IRQ);
+}
+
+static int __init subleq_register_virtio(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < SUBLEQ_VIRTIO_SLOTS; i++) {
+		unsigned long base = SUBLEQ_VIRTIO_BASE + i * SUBLEQ_VIRTIO_STRIDE;
+		void __iomem *regs = (void __iomem *)base; /* flat NOMMU */
+		struct resource res[] = {
+			DEFINE_RES_MEM(base, SUBLEQ_VIRTIO_STRIDE),
+			DEFINE_RES_IRQ(SUBLEQ_VIRTIO_IRQ),
+		};
+		struct platform_device_info info = {
+			.name = "virtio-mmio", .id = i,
+			.res = res, .num_res = ARRAY_SIZE(res),
+			.dma_mask = DMA_BIT_MASK(32),
+		};
+		struct platform_device *pdev;
+		u32 id;
+
+		if (readl(regs + VIRTIO_MMIO_MAGIC_VALUE) != 0x74726976 ||
+		    readl(regs + VIRTIO_MMIO_VERSION) != 2)
+			continue;
+		id = readl(regs + VIRTIO_MMIO_DEVICE_ID);
+		if (id != (i == 2 ? VIRTIO_ID_RNG :
+			   i == 1 ? VIRTIO_ID_NET : VIRTIO_ID_BLOCK)) {
+			if (i == 3)
+				pr_err("subleq: required fourth block slot missing\n");
+			continue;
+		}
+		if (id == VIRTIO_ID_BLOCK) {
+			writel(0, regs + VIRTIO_MMIO_DEVICE_FEATURES_SEL);
+			if (readl(regs + VIRTIO_MMIO_DEVICE_FEATURES) & BIT(VIRTIO_BLK_F_CONFIG_WCE)) {
+				pr_warn("subleq: block slot requires config-wce=off\n");
+				continue;
+			}
+		}
+		pdev = platform_device_register_full(&info);
+		if (IS_ERR(pdev))
+			return PTR_ERR(pdev);
+		WRITE_ONCE(subleq_virtio_registered, subleq_virtio_registered | BIT(i));
+	}
+	return 0;
+}
+arch_initcall(subleq_register_virtio);
