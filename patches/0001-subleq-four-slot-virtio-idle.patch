diff --git a/arch/subleq/include/asm/io.h b/arch/subleq/include/asm/io.h
index 5dccf3ce3..1275d1ba6 100644
--- a/arch/subleq/include/asm/io.h
+++ b/arch/subleq/include/asm/io.h
@@ -23,6 +23,70 @@
 #define __raw_writew(v, a) (*(volatile u16 __force *)(a) = (v))
 #define __raw_writel(v, a) (*(volatile u32 __force *)(a) = (v))
 
+#ifdef CONFIG_SUBLEQ_QEMU_VIRTIO
+#include <linux/bug.h>
+#include <asm/qemu-virtio.h>
+
+/* Modern net/blk configuration reads can extract little-endian lanes
+ * from aligned words. There is no subword device write on this machine.
+ */
+static inline u32 subleq_virtio_lanes(unsigned long addr)
+{
+	return subleq_mmio_read32((const void __iomem *)(addr & ~3UL))
+		>> (8 * (addr & 3));
+}
+
+#define readb readb
+static inline u8 readb(const volatile void __iomem *p)
+{
+	if (subleq_virtio_addr((unsigned long)p))
+		return subleq_virtio_lanes((unsigned long)p);
+	return __raw_readb(p);
+}
+
+#define readw readw
+static inline u16 readw(const volatile void __iomem *p)
+{
+	if (!subleq_virtio_addr((unsigned long)p))
+		return __raw_readw(p);
+	if (WARN_ON_ONCE((unsigned long)p & 1))
+		return 0;
+	return subleq_virtio_lanes((unsigned long)p);
+}
+
+#define readl readl
+static inline u32 readl(const volatile void __iomem *p)
+{
+	if (!subleq_virtio_addr((unsigned long)p))
+		return __raw_readl(p);
+	if (WARN_ON_ONCE((unsigned long)p & 3))
+		return 0;
+	return subleq_mmio_read32(p);
+}
+
+#define writeb writeb
+static inline void writeb(u8 value, volatile void __iomem *p)
+{
+	if (!WARN_ON_ONCE(subleq_virtio_addr((unsigned long)p)))
+		__raw_writeb(value, p);
+}
+
+#define writew writew
+static inline void writew(u16 value, volatile void __iomem *p)
+{
+	if (!WARN_ON_ONCE(subleq_virtio_addr((unsigned long)p)))
+		__raw_writew(value, p);
+}
+
+#define writel writel
+static inline void writel(u32 value, volatile void __iomem *p)
+{
+	if (!subleq_virtio_addr((unsigned long)p))
+		__raw_writel(value, p);
+	else if (!WARN_ON_ONCE((unsigned long)p & 3))
+		subleq_mmio_write32(p + SUBLEQ_VIRTIO_ALIAS, value);
+}
+#else
 #define readb(a) __raw_readb(a)
 #define readw(a) __raw_readw(a)
 #define readl(a) __raw_readl(a)
@@ -30,6 +94,7 @@
 #define writeb(v, a) __raw_writeb(v, a)
 #define writew(v, a) __raw_writew(v, a)
 #define writel(v, a) __raw_writel(v, a)
+#endif
 
 #define readb_relaxed(a) readb(a)
 #define readw_relaxed(a) readw(a)
diff --git a/arch/subleq/include/asm/qemu-virtio.h b/arch/subleq/include/asm/qemu-virtio.h
new file mode 100644
index 000000000..21845b83c
--- /dev/null
+++ b/arch/subleq/include/asm/qemu-virtio.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_SUBLEQ_QEMU_VIRTIO_H
+#define _ASM_SUBLEQ_QEMU_VIRTIO_H
+
+#define SUBLEQ_VIRTIO_BASE	0x60000000UL
+#define SUBLEQ_VIRTIO_STRIDE	0x1000UL
+/* Four-slot machine extension; not available on legacy ESI machines. */
+#define SUBLEQ_VIRTIO_SLOTS	4
+#define SUBLEQ_VIRTIO_ALIAS	0x01000000UL /* displacement from read window */
+#define SUBLEQ_VIRTIO_PENDING	0x62000000UL
+#define SUBLEQ_VIRTIO_IRQ	1
+
+u32 subleq_mmio_read32(const volatile void __iomem *addr);
+void subleq_mmio_write32(volatile void __iomem *alias, u32 value);
+void subleq_dispatch_virtio_irq(void);
+
+static inline bool subleq_virtio_addr(unsigned long addr)
+{
+	return addr - SUBLEQ_VIRTIO_BASE < SUBLEQ_VIRTIO_SLOTS * SUBLEQ_VIRTIO_STRIDE;
+}
+#endif
